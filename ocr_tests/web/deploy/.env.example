# Copy to .env, fill in, and keep it private (chmod 600 .env). Never commit it.
RD_DOMAIN=desk.example.com
# A key made for this site alone (not the one used for tests), with a budget alert on the Google account
GEMINI_API_KEY=
# who may sign in: name:code. Make a code with:  docker compose run --rm app python3 ocr_tests/web/server.py --new-code
RD_USERS=owner:replace-with-a-long-random-code
RD_SITE_NAME=Reading Desk
RD_CONTACT=
RD_JOB_BUDGET_INR=40
RD_DAILY_BUDGET_INR=150
RD_MONTHLY_BUDGET_INR=600
RD_RETENTION_HOURS=72
