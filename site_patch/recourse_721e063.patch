diff --git a/register_hooks.py b/register_hooks.py
new file mode 100644
index 0000000..728240c
--- /dev/null
+++ b/register_hooks.py
@@ -0,0 +1,108 @@
+"""Fail-open hooks around the Overruled Register bundle (overruled_register/, exported by `python sci_goodlaw.py register-export-site`).
+Order of lookup for a case: the register (person-confirmed rows firmly, candidates as "reported ... not yet confirmed"), then the cards overlay (the checker's reading, precomputed),
+then the fixed "not checked by us" sentence. Nothing here ever says a case is good law. Every function returns its input unchanged (or empty notes) on any error, and REGISTER_HOOKS=off turns all of it off."""
+import logging
+import os
+
+logger = logging.getLogger(__name__)
+_STATE = {}
+
+
+def _off():
+    return os.environ.get("REGISTER_HOOKS", "on").strip().lower() in ("off", "0", "false", "no")
+
+
+def _load():
+    if "reg" not in _STATE:
+        import overruled_register as OR
+        _STATE["reg"] = OR.load()
+        try:
+            _STATE["ov"] = OR.load_overlay()
+        except Exception as exc:  # the register alone still works
+            logger.warning("cards overlay not loaded: %s", exc)
+            _STATE["ov"] = None
+    return _STATE["reg"], _STATE["ov"]
+
+
+def prompt_lines_for_match(m):
+    """Lock (b): lines for the prompt about the retrieved case itself."""
+    if _off():
+        return []
+    try:
+        from overruled_register import register_guard as G
+        reg, _ = _load()
+        return G.prompt_facts(reg, [" ".join(str(x) for x in (m.get("case_name"), m.get("year"), m.get("citation")) if x)])
+    except Exception as exc:
+        logger.warning("register prompt lines failed: %s", exc)
+        return []
+
+
+def demote_matches(matches):
+    """Lock (a): a retrieved judgment whose own case is a firm register row goes to the end of the list and carries m['register_badge']; a candidate row only carries the badge."""
+    if _off():
+        return matches
+    try:
+        from overruled_register import register_guard as G
+        reg, _ = _load()
+        chunks = [{"case_name": m.get("case_name"), "year": m.get("year"), "citation": m.get("citation"), "text": None} for m in matches]
+        flags = G.retrieval_flags(reg, chunks)
+        keep, last = [], []
+        for m, f in zip(matches, flags):
+            if f["action"] in ("badge", "demote_and_badge") and isinstance(m, dict):
+                m["register_badge"] = f["own"]
+            (last if f["action"] == "demote_and_badge" else keep).append(m)
+        return keep + last
+    except Exception as exc:
+        logger.warning("register demotion failed: %s", exc)
+        return matches
+
+
+def answer_notes(text, exclude_names=()):
+    """Lock (c): {'notes': [sentences to show], 'not_checked': one fixed sentence or None, 'review': [weak matches for a person]} for a finished answer.
+    notes = the register's sentences, then the checker's warning cards (worded as the card words them); a quiet card adds nothing."""
+    empty = {"notes": [], "not_checked": None, "review": []}
+    if _off():
+        return empty
+    try:
+        from overruled_register import overlay as OV
+        reg, ov = _load()
+        res = OV.audit_answer(reg, ov, text or "", exclude_names=exclude_names)
+        notes = list(res["register_notes"])
+        for c in res["card_notes"]:
+            notes.append(f'{c["case"]}: {c["note"]}')
+        return {"notes": notes, "not_checked": res.get("not_checked_sentence"), "review": res["review"]}
+    except Exception as exc:
+        logger.warning("register guard failed: %s", exc)
+        return empty
+
+
+def result_flags(results):
+    """For the wider-pool search tier (sci_search_tier.py): one dict per result, in order -- {'source': 'register'|'card'|'card_quiet'|'none', 'note': sentence or None}.
+    The register first (firm or 'reported ... not yet confirmed'), then the cards overlay's warning or caution, else nothing; a quiet card is recorded but gives no sentence. Never raises."""
+    out = [{"source": "none", "note": None} for _ in results]
+    if _off():
+        return out
+    try:
+        reg, ov = _load()
+        for i, r in enumerate(results):
+            name = r.get("case_name")
+            if not name or r.get("name_to_review"):
+                continue
+            year = int(r["date"][:4]) if r.get("date") else None
+            cits = r.get("citations") or {}
+            def _one(v):                       # the names table holds a string for open-bucket judgments and a list for crawl judgments
+                return v[0] if isinstance(v, (list, tuple)) and v else (v if isinstance(v, str) else None)
+            cit = _one(cits.get("scr")) or _one(cits.get("insc")) or _one(cits.get("air")) or None
+            hits = [h for h in reg.lookup_case(name, year, cit) if h["strength"] == "strong" and reg.clause(h["row"])]
+            if hits:
+                row = hits[0]["row"]
+                out[i] = {"source": "register", "note": reg.clause_group([row] + reg.same_decision_rows(row))}
+                continue
+            e = ov.lookup(name, year, cit) if ov else None
+            if e and e["kind"] in ("warning", "caution"):
+                out[i] = {"source": "card", "note": e["note"]}
+            elif e and e["kind"] == "quiet":
+                out[i] = {"source": "card_quiet", "note": None}
+    except Exception as exc:
+        logger.warning("register result flags failed: %s", exc)
+    return out
diff --git a/sci_search_tier.py b/sci_search_tier.py
new file mode 100644
index 0000000..8c0727c
--- /dev/null
+++ b/sci_search_tier.py
@@ -0,0 +1,127 @@
+"""The wider-pool search tier on the website side: asks the private sci-search service (recourse-sci-pool, sci_search_service.py) for Supreme Court passages and either logs them (shadow) or hands them
+to the page (show). Fail-open: any problem, a slow service, a missing setting -- the answer goes out exactly as it does without this module.
+
+    SCI_SEARCH_MODE   off (default) | shadow | show
+    SCI_SEARCH_URL    base address of the service, for example http://sci-search.railway.internal:8080
+    SCI_SEARCH_TOKEN  the shared secret (header X-Search-Token)
+    SCI_SEARCH_TIMEOUT  seconds to wait in show mode (default 6)
+    SCI_SHADOW_LOG_QUESTIONS  1 to write the question text into the shadow log (default: only a hash; legal questions are private)
+    SCI_SHADOW_LOG_FILE  optional path (a volume) to append the shadow records to; they always go to the application log as lines starting SCI_SHADOW
+
+shadow: the search runs in a background thread AFTER the answer is built; the user sees nothing and waits for nothing. show: the search runs before the answer is returned (up to the timeout) and
+result['sci_related_judgments'] holds the passages, each with the register/card note beside it; the website shows them in their own box, labelled not independently verified.
+Nothing here says a case is good law.
+"""
+import hashlib
+import json
+import logging
+import os
+import threading
+import time
+import urllib.error
+import urllib.request
+
+logger = logging.getLogger(__name__)
+MODES = ("off", "shadow", "show")
+MAX_SHOWN = 5
+EXCERPT = 600
+
+
+def mode():
+    m = (os.environ.get("SCI_SEARCH_MODE") or "off").strip().lower()
+    return m if m in MODES else "off"
+
+
+def search(question, timeout=None, k=10):
+    """The service's answer dict, or None on any failure (never raises)."""
+    base = (os.environ.get("SCI_SEARCH_URL") or "").rstrip("/")
+    if not base or not question:
+        return None
+    try:
+        timeout = float(timeout if timeout is not None else os.environ.get("SCI_SEARCH_TIMEOUT") or 6)
+        headers = {"Content-Type": "application/json"}
+        if os.environ.get("SCI_SEARCH_TOKEN"):
+            headers["X-Search-Token"] = os.environ["SCI_SEARCH_TOKEN"]
+        req = urllib.request.Request(base + "/search", data=json.dumps({"question": question, "k": k}).encode("utf-8"), headers=headers, method="POST")
+        with urllib.request.urlopen(req, timeout=timeout) as r:
+            body = json.loads(r.read().decode("utf-8"))
+        return body if isinstance(body, dict) and body.get("ok") and isinstance(body.get("results"), list) else None
+    except urllib.error.HTTPError as exc:
+        logger.warning("sci-search answered %s", exc.code)
+    except Exception as exc:  # noqa: BLE001 -- fail-open
+        logger.warning("sci-search failed: %s", type(exc).__name__)
+    return None
+
+
+def _flags(results):
+    try:
+        from register_hooks import result_flags
+        return result_flags(results)
+    except Exception:  # noqa: BLE001
+        return [{"source": "none", "note": None} for _ in results]
+
+
+def shadow_record(question, found, answer_result=None):
+    """What the shadow log holds for one question: the passages, the register/card verdict on each, and how many cases in the answer's own sources overlap."""
+    results = found["results"]
+    flags = _flags(results)
+    rec = {"t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "q_hash": hashlib.sha256(question.encode("utf-8")).hexdigest()[:16],
+           "index_commit": found.get("index_commit"), "seconds": found.get("seconds"),
+           "state": (answer_result or {}).get("state"),
+           "results": [{"rank": r.get("rank"), "doc": r.get("doc"), "case": r.get("case_name"), "date": r.get("date"), "para": r.get("paragraph"), "name_to_review": r.get("name_to_review"),
+                        "flag": f["source"], "note": f["note"]} for r, f in zip(results, flags)]}
+    rec["flagged"] = sum(1 for f in flags if f["source"] in ("register", "card"))
+    if os.environ.get("SCI_SHADOW_LOG_QUESTIONS") == "1":
+        rec["question"] = question
+    return rec
+
+
+def _write_shadow(question, answer_result):
+    try:
+        found = search(question, timeout=30)
+        if not found:
+            return
+        rec = shadow_record(question, found, answer_result)
+        line = json.dumps(rec, ensure_ascii=False)
+        print("SCI_SHADOW " + line, flush=True)             # stdout: the application's logger is at WARNING level on Railway, so logger.info would never show
+        path = os.environ.get("SCI_SHADOW_LOG_FILE")
+        if path:
+            with open(path, "a", encoding="utf-8") as fh:
+                fh.write(line + "\n")
+    except Exception as exc:  # noqa: BLE001
+        logger.warning("sci shadow logging failed: %s", type(exc).__name__)
+
+
+def attach(question, result, background=True):
+    """Called at the end of chat_assistant.answer_question. Returns `result` (changed only in show mode, and only by adding 'sci_related_judgments'). Never raises."""
+    try:
+        m = mode()
+        if m == "off" or not isinstance(result, dict) or result.get("state") not in ("single_match", "conflicting_matches"):
+            return result
+        if m == "shadow":
+            t = threading.Thread(target=_write_shadow, args=(question, dict(result)), daemon=True)
+            t.start()
+            if not background:
+                t.join()
+            return result
+        found = search(question)
+        if not found:
+            return result
+        res = found["results"][:MAX_SHOWN * 2]
+        flags = _flags(res)
+        shown, seen = [], set()
+        for r, f in zip(res, flags):
+            if r.get("name_to_review") or not r.get("case_name") or r["doc"] in seen:
+                continue                                        # a judgment with no readable name is not shown to a person
+            seen.add(r["doc"])
+            txt = (r.get("text") or "")[:EXCERPT]
+            shown.append({"case_name": r["case_name"], "date": r.get("date"), "paragraph": r.get("paragraph"), "link": r.get("link"), "link_kind": r.get("link_kind"),
+                          "excerpt": txt, "register_note": f["note"] if f["source"] in ("register", "card") else None})
+            if len(shown) >= MAX_SHOWN:
+                break
+        if shown:
+            result["sci_related_judgments"] = shown
+            result["sci_as_of"] = found.get("as_of")
+    except Exception as exc:  # noqa: BLE001 -- fail-open
+        logger.warning("sci tier attach failed: %s", type(exc).__name__)
+    return result
