new file mode 100644
index 0000000..350ab38
--- /dev/null
+++ b/test_register_hooks.py
@@ -0,0 +1,89 @@
+"""
+test_register_hooks.py -- the Overruled Register hooks (register_hooks.py + the three call sites in chat_assistant.py / recourse_app.py).
+Fully offline and free: no API calls, nothing written. Run: python -X utf8 test_register_hooks.py
+"""
+import os
+import sys
+
+import chat_assistant as CA
+import register_hooks as RH
+
+FAILURES = []
+
+
+def check(cond, msg):
+    print(f"[{'PASS' if cond else 'FAIL'}] {msg}")
+    if not cond:
+        FAILURES.append(msg)
+
+
+os.environ.pop("REGISTER_HOOKS", None)
+OLD = {"case_name": "Raja Ram Verma v. State of U.P. and Others", "year": 1968, "text": "old holding", "paragraph_number": "5"}
+CAND = {"case_name": "Mohan Lal v State of Punjab", "citation": "(2018) 17 SCC 627", "text": "x", "paragraph_number": "7"}
+FINE = {"case_name": "Arnesh Kumar v State of Bihar", "citation": "(2014) 8 SCC 273", "text": "y", "paragraph_number": "9"}
+STATUTE = {"act": "BNS", "section_number": "318", "text": "cheating"}
+
+# lock (a): retrieval
+out = RH.demote_matches([OLD, CAND, FINE, STATUTE])
+check([m.get("case_name") or m.get("section_number") for m in out][-1] == OLD["case_name"], "a firm register case goes to the end of the list")
+check(OLD.get("register_badge") and CAND.get("register_badge"), "firm and candidate rows both carry a badge")
+check(out[0] is CAND and "register_badge" not in FINE, "a candidate row is badged but not demoted; an unlisted case is untouched")
+check(RH.demote_matches(None) is None, "bad input is returned as it came (fail-open)")
+
+# lock (b): prompt
+text = CA.format_retrieved_text_for_prompt([dict(OLD), dict(CAND), dict(FINE)])
+check("REGISTER FACT" in text and "Raja Ram Verma" in text, "a firm row puts a REGISTER FACT line in the prompt")
+check("REGISTER NOTE (not yet confirmed)" in text, "a candidate row puts a 'not yet confirmed' line in the prompt")
+check(text.count("[Overruled Register") == 2, "an unlisted case adds no register block")
+check(text.index("Arnesh Kumar") < text.index("Raja Ram Verma"), "and the demoted case comes after the others in the prompt")
+check("A line that starts REGISTER FACT is not optional" in CA.RESPONSE_GENERATION_PROMPT, "the system prompt carries the REGISTER FACT rule")
+
+# lock (c): the finished answer
+ans = {"state": "single_match", "response_text": "The Supreme Court in Mohan Lal v. State of Punjab (2018) 17 SCC 627 held that X. Also see Ram Prasad v. State of Bihar (2003) 1 SCC 1."}
+res = CA._attach_register_notes(dict(ans))
+check(len(res.get("register_notes", [])) >= 1 and any("Mohan Lal" in n for n in res["register_notes"]), "an answer that cites a register case gets its note")
+check("Ram Prasad v. State of Bihar" in (res.get("register_not_checked") or ""), "a case on neither list is named in the fixed 'not checked' sentence")
+ack = {"state": "single_match", "response_text": "Mohan Lal v. State of Punjab (2018) 17 SCC 627 was later overruled by Mukesh Singh (2020)."}
+check("register_notes" not in CA._attach_register_notes(dict(ack)), "an answer that already says it was overruled gets no second note")
+other = {"state": "no_match", "response_text": ans["response_text"]}
+check("register_notes" not in CA._attach_register_notes(dict(other)), "a non-answer state is left alone")
+check(CA._attach_register_notes("not a dict") == "not a dict", "bad input does not raise")
+
+# switch and fail-open
+os.environ["REGISTER_HOOKS"] = "off"
+check(RH.demote_matches([OLD, CAND]) == [OLD, CAND] and RH.prompt_lines_for_match(OLD) == [] and RH.answer_notes(ans["response_text"])["notes"] == [], "REGISTER_HOOKS=off turns all three locks off")
+check("REGISTER FACT" not in CA.format_retrieved_text_for_prompt([dict(OLD)]), "and the prompt is unchanged")
+os.environ.pop("REGISTER_HOOKS")
+RH._STATE.clear()
+import builtins
+real_import = builtins.__import__
+
+
+def broken(name, *a, **k):
+    if name.startswith("overruled_register"):
+        raise ImportError("bundle missing")
+    return real_import(name, *a, **k)
+
+
+builtins.__import__ = broken
+try:
+    RH._STATE.clear()
+    sys.modules.pop("overruled_register", None)
+    ok = RH.answer_notes("x v. y (2001)")["notes"] == [] and RH.prompt_lines_for_match(OLD) == []
+finally:
+    builtins.__import__ = real_import
+check(ok, "with the bundle missing every hook returns empty and does not raise")
+
+# the case the answer itself relies on (listed by the site as a source) is not called "not checked"
+scen = {"state": "single_match", "response_text": "The Constitution Bench in Mukesh Singh v. State (Narcotic Branch of Delhi) held that the dual role is not by itself fatal. It overruled the earlier line, including Mohan Lal v. State of Punjab (2018) 17 SCC 627.",
+        "cited_judgment_links": [{"case_name": "Mukesh Singh v State (Narcotic Branch of Delhi)", "url": "https://x"}]}
+r_s = CA._attach_register_notes(dict(scen))
+check(any("Mohan Lal" in n for n in r_s.get("register_notes", [])) and "register_not_checked" not in r_s, f"the overruling case and the listed source are not called 'not checked': {r_s.get('register_not_checked')}")
+
+# WhatsApp: the same notes go out as one message, before the judgment links
+import whatsapp_formatter as WF
+msgs = WF.format_answer_for_whatsapp({"state": "single_match", "response_text": "Some answer.", "register_notes": ["Mohan Lal v. State of Punjab (2018): reported to have been overruled."], "register_not_checked": "Cases named in this answer that we have not checked: X v. Y."})
+check(any(m.startswith("*Currency notes*") and "Mohan Lal" in m and "not checked" in m for m in msgs), "WhatsApp carries the register notes and the 'not checked' sentence as one message")
+check(WF.format_answer_for_whatsapp({"state": "single_match", "response_text": "Some answer."}) == ["Some answer."], "and an answer without notes is unchanged")
+print("\nALL PASSED" if not FAILURES else f"\n{len(FAILURES)} FAILED: {FAILURES}")
+sys.exit(1 if FAILURES else 0)
diff --git a/test_sci_search_tier.py b/test_sci_search_tier.py
new file mode 100644
index 0000000..519a877
--- /dev/null
+++ b/test_sci_search_tier.py
@@ -0,0 +1,130 @@
+"""
+test_sci_search_tier.py -- the wider-pool search tier on the website side (sci_search_tier.py + its call in chat_assistant.answer_question + the page box).
+Fully offline and free: a local stand-in for the sci-search service, no model, no network beyond localhost. Run: python -X utf8 test_sci_search_tier.py
+"""
+import json
+import os
+import sys
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import sci_search_tier as T
+
+FAILURES = []
+
+
+def check(cond, msg):
+    print(f"[{'PASS' if cond else 'FAIL'}] {msg}")
+    if not cond:
+        FAILURES.append(msg)
+
+
+SEEN = {"calls": 0, "token": None, "body": None}
+MODE = {"kind": "ok"}
+RES = [
+    {"rank": 1, "doc": 1, "case_name": "Raj Deo Sharma v. The State of Bihar", "date": "1999-05-03", "paragraph": "5", "link": "https://api.sci.gov.in/jonew/judis/1.pdf", "link_kind": "court_archive_pdf", "text": "Time limit held X.", "name_to_review": False, "citations": {"air": ["1999 AIR 2000"], "scr": ["1999 SCR (3) 1"]}},
+    {"rank": 2, "doc": 2, "case_name": "Arnesh Kumar v. State of Bihar", "date": "2014-07-02", "paragraph": "9", "link": "https://x/2.pdf", "link_kind": "open_bucket_pdf", "text": "Arrest guidelines.", "name_to_review": False, "citations": {}},
+    {"rank": 3, "doc": 3, "case_name": None, "date": None, "paragraph": "1", "link": "https://api.sci.gov.in/jonew/judis/3.pdf", "link_kind": "court_archive_pdf", "text": "unnamed", "name_to_review": True, "citations": {}},
+    {"rank": 4, "doc": 1, "case_name": "Raj Deo Sharma v. The State of Bihar", "date": "1999-05-03", "paragraph": "7", "link": "https://api.sci.gov.in/jonew/judis/1.pdf", "link_kind": "court_archive_pdf", "text": "again", "name_to_review": False, "citations": {}},
+]
+
+
+class H(BaseHTTPRequestHandler):
+    def log_message(self, *a):
+        pass
+
+    def do_POST(self):
+        SEEN["calls"] += 1
+        SEEN["token"] = self.headers.get("X-Search-Token")
+        SEEN["body"] = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)))
+        if MODE["kind"] == "slow":
+            time.sleep(3)
+        code, body = (503, {"ok": False}) if MODE["kind"] == "down" else (200, {"ok": True, "tier": "x", "index_commit": "abc", "as_of": "2026-07-13", "seconds": 1.0, "results": RES})
+        data = json.dumps(body).encode()
+        self.send_response(code)
+        self.send_header("Content-Length", str(len(data)))
+        self.end_headers()
+        try:
+            self.wfile.write(data)
+        except BrokenPipeError:
+            pass
+
+
+srv = ThreadingHTTPServer(("127.0.0.1", 0), H)
+threading.Thread(target=srv.serve_forever, daemon=True).start()
+os.environ["SCI_SEARCH_URL"] = f"http://127.0.0.1:{srv.server_address[1]}"
+os.environ["SCI_SEARCH_TOKEN"] = "sekrit"
+ANS = {"state": "single_match", "response_text": "An answer."}
+
+# off (the default): nothing happens, nothing is called
+os.environ.pop("SCI_SEARCH_MODE", None)
+r = T.attach("q", dict(ANS))
+check(r == ANS and SEEN["calls"] == 0, "off is the default: the answer is untouched and the service is not called")
+os.environ["SCI_SEARCH_MODE"] = "banana"
+check(T.mode() == "off", "an unknown mode means off")
+
+# shadow: the answer is untouched, the call happens in the background, the log holds a hash and not the question
+os.environ["SCI_SEARCH_MODE"] = "shadow"
+logfile = os.path.join(os.environ.get("TMPDIR", "/tmp"), f"shadow_{os.getpid()}.jsonl")
+os.environ["SCI_SHADOW_LOG_FILE"] = logfile
+MODE["kind"] = "slow"
+t0 = time.time()
+r = T.attach("Can police arrest me for cheating?", dict(ANS))
+check(r == ANS and time.time() - t0 < 1.0, "shadow does not change the answer and does not make the user wait for a slow service")
+time.sleep(4.5)
+check(SEEN["calls"] == 1 and SEEN["token"] == "sekrit" and SEEN["body"]["question"] == "Can police arrest me for cheating?", "the service was called with the token and the question")
+rec = json.loads(open(logfile, encoding="utf-8").readline())
+check("question" not in rec and len(rec["q_hash"]) == 16, "the shadow log has a hash of the question, not the text, by default")
+check(len(rec["results"]) == 4 and rec["results"][0]["flag"] == "register" and "overruled" in (rec["results"][0]["note"] or "").lower(), f"and a register flag on Raj Deo Sharma (overruled): {rec['results'][0]['flag']}")
+check(rec["flagged"] >= 1 and rec["results"][2]["flag"] == "none", "unnamed judgments are not looked up")
+# the shadow line goes to stdout (what Railway's log shows), and a list-valued citation (crawl judgments) does not break the flags
+import io, contextlib
+buf = io.StringIO()
+with contextlib.redirect_stdout(buf):
+    T.attach("third question", dict(ANS), background=False)
+out_lines = [l for l in buf.getvalue().splitlines() if l.startswith("SCI_SHADOW ")]
+check(len(out_lines) == 1 and json.loads(out_lines[0][len("SCI_SHADOW "):])["results"][0]["flag"] == "register", "the shadow record is printed to stdout as one 'SCI_SHADOW {...}' line, with the register flag even when the citation is a list")
+os.environ["SCI_SHADOW_LOG_QUESTIONS"] = "1"
+MODE["kind"] = "ok"
+T.attach("second?", dict(ANS), background=False)
+rec2 = [json.loads(l) for l in open(logfile, encoding="utf-8")][-1]
+check(rec2.get("question") == "second?", "with SCI_SHADOW_LOG_QUESTIONS=1 the text is logged")
+os.environ.pop("SCI_SHADOW_LOG_QUESTIONS")
+
+# show: passages attached, unnamed and repeated judgments left out, register note carried
+os.environ["SCI_SEARCH_MODE"] = "show"
+r = T.attach("q", dict(ANS))
+sh = r.get("sci_related_judgments") or []
+check([j["case_name"] for j in sh] == ["Raj Deo Sharma v. The State of Bihar", "Arnesh Kumar v. State of Bihar"], "show: named judgments only, each once")
+check(sh and sh[0]["register_note"] and sh[1]["register_note"] is None and sh[0]["link"].startswith("https://api.sci.gov.in/"), "the register note sits beside the overruled case, links are kept")
+check(r["sci_as_of"] == "2026-07-13" and r["response_text"] == "An answer.", "the as-of date is attached and the answer text is untouched")
+check("sci_related_judgments" not in T.attach("q", {"state": "no_match"}), "a non-answer state gets nothing")
+
+# fail-open
+MODE["kind"] = "down"
+check(T.attach("q", dict(ANS)) == ANS, "a service that answers 503 leaves the answer as it was")
+MODE["kind"] = "slow"
+os.environ["SCI_SEARCH_TIMEOUT"] = "1"
+t0 = time.time()
+check(T.attach("q", dict(ANS)) == ANS and time.time() - t0 < 2.5, "show mode gives up after the timeout and the answer goes out")
+os.environ["SCI_SEARCH_URL"] = "http://127.0.0.1:1"
+check(T.attach("q", dict(ANS)) == ANS, "a service that cannot be reached leaves the answer as it was")
+os.environ.pop("SCI_SEARCH_URL")
+check(T.attach("q", dict(ANS)) == ANS, "no address set: nothing happens")
+check(T.attach("q", "not a dict") == "not a dict", "bad input does not raise")
+
+# the call in answer_question
+import chat_assistant as CA
+os.environ["SCI_SEARCH_MODE"] = "show"
+os.environ["SCI_SEARCH_URL"] = f"http://127.0.0.1:{srv.server_address[1]}"
+MODE["kind"] = "ok"
+os.environ["SCI_SEARCH_TIMEOUT"] = "6"
+CA._answer_question_core = lambda q, inline_domains=frozenset(): {"state": "single_match", "response_text": "Core answer."}
+out = CA.answer_question("a question")
+check(out.get("sci_related_judgments") and out["response_text"] == "Core answer.", "answer_question carries the tier in show mode")
+os.environ["SCI_SEARCH_MODE"] = "off"
+check("sci_related_judgments" not in CA.answer_question("a question"), "and nothing with the mode off")
+
+print("\nALL PASSED" if not FAILURES else f"\n{len(FAILURES)} FAILED: {FAILURES}")
+sys.exit(1 if FAILURES else 0)
